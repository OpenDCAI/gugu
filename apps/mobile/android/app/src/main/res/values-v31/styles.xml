<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only API31+ can mirror the app theme into the next system starting window. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/gugu_mobile_shell_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowLightStatusBar">@bool/gugu_system_light</item>
        <item name="android:windowLightNavigationBar">@bool/gugu_system_light</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
