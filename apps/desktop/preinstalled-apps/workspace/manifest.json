{
  "id": "workspace",
  "name": "文件夹",
  "defaultLocale": "zh-CN",
  "subtitle": "共享文件：Markdown、JSON 预览与编辑",
  "localized": {
    "en": { "name": "Folder", "subtitle": "Shared Markdown and JSON files" }
  },
  "author": "咕咕",
  "version": "0.2.63",
  "apiVersion": 25,
  "platforms": ["desktop", "phone"],
  "entry": "index.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": ["files:read:all-machines", "files:write", "agents:tools"]
  },
  "contributes": {
    "tabs": [
      {
        "name": "main",
        "title": "文件夹",
        "icon": "icon.png",
        "sideWidth": 480
      },
      {
        "name": "file",
        "title": "文件夹",
        "icon": "icon.png",
        "opensFiles": { "chat": [".md", ".json"] },
        "fileIcons": { ".md": "md.png", ".json": "json.png" },
        "sideWidth": 480
      }
    ],
    "mcpServers": [{ "tools": "tools.js" }],
    "instructions": "Conversation folders: workspace__list(chat_id), create(chat_id,title,content), read/delete(item_id), edit(item_id,old,new). Edits merge live."
  }
}
