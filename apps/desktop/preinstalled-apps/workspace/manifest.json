{
  "id": "workspace",
  "name": "文件",
  "defaultLocale": "zh-CN",
  "subtitle": "聊天文件与电脑文件：Markdown、JSON 预览与编辑",
  "localized": {
    "en": { "name": "Files", "subtitle": "Chat and computer files", "tabs": { "main": { "title": "Files" }, "file": { "title": "Files" } } }
  },
  "author": "咕咕",
  "version": "0.2.75",
  "apiVersion": 30,
  "platforms": ["desktop", "phone"],
  "entry": "index.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": ["files:read:all-machines", "files:write", "agents:tools", "chat:read"]
  },
  "contributes": {
    "tabs": [
      {
        "name": "main",
        "title": "文件",
        "icon": "icon.png",
        "sideWidth": 480
      },
      {
        "name": "file",
        "title": "文件",
        "icon": "icon.png",
        "opensFiles": { "chat": [".md", ".json"], "session": ["*"] },
        "fileIcons": { ".md": "md.png", ".json": "json.png" },
        "sideWidth": 480
      }
    ],
    "mcpServers": [{ "tools": "tools.js" }],
    "instructions": "Chat files: workspace__list(chat_id), create(chat_id,title,content), read/delete(item_id), edit(item_id,old,new). Edits merge live."
  }
}
