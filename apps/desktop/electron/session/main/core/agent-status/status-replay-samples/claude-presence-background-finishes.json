   "expect": "working",
   "finished": false
  },
  {
   "raw": "hook UserPromptSubmit (task-notification)",
   "event": {
    "kind": "Started",
    "sessionId": "7e5c0000-0000-4000-8000-000000000004"
   },
   "drop": null,
   "expect": "working",
   "finished": false
  },
  {
   "raw": "hook Stop background_tasks=[]",
   "event": {
    "kind": "Stopped",
    "sessionId": "7e5c0000-0000-4000-8000-000000000004",
    "backgroundTasks": 0
   },
   "drop": null,
   "expect": "idle",
   "finished": true
  },
  {
