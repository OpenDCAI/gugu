{
  "id": "smoke-node-app",
  "name": "Smoke node App",
  "author": "gugu",
  "version": "1.0.0",
  "apiVersion": 24,
  "defaultLocale": "en",
  "entry": "index.html",
  "permissions": { "capabilities": ["agents:tools"] },
