    "capabilities": [
      "files:read"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "board",
        "title": "站会",
        "toolbar": [
          {
            "id": "rescan",
            "title": "重新扫描"
          },
          {
            "id": "post",
            "title": "放进对话"
          }
        ]
      }
    ]
