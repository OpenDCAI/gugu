{
  "id": "ext-debug",
  "name": "App 调试台",
  "description": "写 App 时用的仪器,不是给日常用的:把桥上每个动词当场跑一遍,哪条挂了就把错误原文摊在脸上。所以它申请了全部能力。",
  "author": "咕咕",
  "categories": [
    "dev-tools"
  ],
  "version": "2.0.0",
  "apiVersion": 15,
  "platforms": ["desktop"],
  "engines": {
    "gugu": ">=0.2.40"
  },
  "entry": "debug.html",
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "agents:read:all",
      "agents:history:all",
      "agents:control:all"
    ],
    "network": [
      "example.com"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "probe",
        "title": "调试台",
        "opensFiles": {
          "session": [
            ".probe"
          ]
        },
        "menu": [
          {
            "id": "menu-ping",
            "title": "菜单回声（调试用）"
          }
        ],
        "toolbar": [
          {
            "id": "rerun",
            "title": "刷新"
          },
          {
            "id": "expand-all",
            "title": "展开全部"
          },
          {
            "id": "collapse-all",
            "title": "折叠全部"
          },
          {
            "id": "copy-json",
            "title": "复制 JSON"
          }
        ]
      }
    ]
  }
}
