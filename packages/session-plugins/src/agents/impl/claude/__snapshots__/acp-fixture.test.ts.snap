558	// ---------------------------------------------------------------------------
559	// Internal helpers
560	// ---------------------------------------------------------------------------
561	
562	function warn(
563	  s: SessionMachineState,
564	  message: string
565	): { state: SessionMachineState; effects: Effect[] } {
566	  return { state: s, effects: [{ type: 'warn', message }] };
567	}
568	
569	function makeTurn(s: SessionMachineState, source: TurnSource): AcpTurn {
570	  return {
571	    id: \`turn-\${s.conversationId}-\${s.nextTurnIndex}\`,
572	    status: 'active',
573	    source,
574	    startSeq: s.nextSeq,
575	    endSeq: null,
576	    stopReason: null,
577	    updates: [],
578	  };
579	}
580	
581	function replaceTurnInPhase(phase: SessionPhase, turn: AcpTurn): SessionPhase {
582	  switch (phase.kind) {
583	    case 'replaying':
584	      return { kind: 'replaying', turn };
585	    case 'working':
586	      return { kind: 'working', turn };
587	    case 'cancelling':
588	      return { kind: 'cancelling', turn };
589	    default:
590	      return phase;
591	  }
592	}
593	
594	/**
595	 * Returns true if the incoming session setup event carries metadata that differs
596	 * from what the machine already has. Used to decide whether to emit a \`meta\`
597	 * effect alongside the \`state\` effect.
598	 */
599	function needsMetaEffect(
600	  s: SessionMachineState,
601	  ev: { modes?: SessionModeState | null; configOptions?: readonly SessionConfigOption[] | null }
602	): boolean {
603	  return ev.modes !== undefined || ev.configOptions !== undefined;
604	}
605	
606	// ---------------------------------------------------------------------------
607	// isPromptReady — shared predicate (no longer from affordances.ts)
