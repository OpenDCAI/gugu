              "outputText": "1	/**
2	 * Pure ACP session state machine.
3	 *
4	 * Separates inputs into two distinct kinds:
5	 *
6	 * - Commands — intents from the public API that MAY be rejected by validation.
7	 *   They produce zero or more DomainEvents on success, or an AcpRuntimeError on
8	 *   failure. No state changes occur on rejection.
9	 *
10	 * - DomainEvents — facts from the agent process, ACP notifications, or our own
11	 *   orchestration that are ALWAYS folded into state. An out-of-place event
12	 *   yields only a diagnostic \`warn\` Effect, never an error.
13	 *
14	 * The two pure functions \`decide\` and \`evolve\` contain no I/O. The runtime
15	 * feeds commands through \`decide\` to get events, then feeds events through
16	 * \`evolve\` to get the next state and the list of Effects to perform.
17	 *
18	 * State machine transitions:
19	 *
20	 *   starting → replaying (E: ReplayStarted — only when loadSession capable)
21	 *   starting → ready     (E: SessionReady — newSession path)
22	 *   replaying → ready    (E: ReplayEnded)
23	 *   ready → working      (C: Prompt → E: PromptStarted)
24	 *   working → ready      (E: TurnEnded)
25	 *   working → cancelling (C: Cancel → E: CancellationRequested)
26	 *   cancelling → ready   (E: TurnEnded)
27	 *   {ready,working,cancelling} → closed (E: ProcessClosed)
28	 */
29	
30	import type {
31	  AvailableCommand,
32	  SessionConfigOption,
33	  SessionModeState,
34	  StopReason,
35	} from '@agentclientprotocol/sdk';
36	import type { Result } from '@gugu/session-shared';
37	import { ok } from '@gugu/session-shared';
38	import type { AgentUpdate } from './agent-update';
39	import type { AcpRuntimeError } from './errors';
40	import { acpErr } from './errors';
41	import type { AcpPermissionRequest } from './permissions';
42	import type {
43	  AcpTurn,
44	  ChatHistory,
45	  SessionSnapshot,
46	  SessionState,
47	  SessionUsage,
48	  TurnSource,
49	  TurnStatus,
50	} from './state';
51	
52	// Re-export the snapshot mirror primitives so renderer-safe consumers can import
53	// them from this node-free entry instead of the full \`@gugu/session-core/acp\` barrel.
54	export { toSessionSnapshot, type SessionSnapshot } from './state';
55	
56	// ---------------------------------------------------------------------------
57	// Phase (discriminated union carrying the active turn in-line)
58	// ---------------------------------------------------------------------------
59	
60	export type SessionPhase =
61	  | { kind: 'starting' }
62	  | { kind: 'replaying'; turn: AcpTurn }
63	  | { kind: 'ready' }
64	  | { kind: 'working'; turn: AcpTurn }
65	  | { kind: 'cancelling'; turn: AcpTurn }
66	  | { kind: 'closed'; exitCode: number | null };
67	
68	/** Derives the \`SessionLifecycle\` string from a phase. */
69	export function phaseToLifecycle(phase: SessionPhase): SessionLifecycle {
70	  return phase.kind;
71	}
72	
73	/** The active turn if the phase carries one, otherwise null. */
74	export function activeTurnFromPhase(phase: SessionPhase): AcpTurn | null {
75	  if (phase.kind === 'replaying' || phase.kind === 'working' || phase.kind === 'cancelling') {
76	    return phase.turn;
77	  }
78	  return null;
79	}
80	
81	// Re-export for consumers that only care about the lifecycle string
82	export type SessionLifecycle =
83	  | 'starting'
84	  | 'replaying'
85	  | 'ready'
86	  | 'working'
87	  | 'cancelling'
88	  | 'closed';
89	
90	// ---------------------------------------------------------------------------
91	// Machine state
92	// ---------------------------------------------------------------------------
93	
94	export interface SessionMachineState {
95	  readonly conversationId: string;
96	  readonly phase: SessionPhase;
97	  readonly committedTurns: readonly AcpTurn[];
98	  readonly pendingPermissions: readonly AcpPermissionRequest[];
99	  /**
100	   * Agent-advertised session modes. Null until the first newSession or
101	   * loadSession response arrives, or if the agent doesn't support modes.
102	   */
103	  readonly modes: SessionModeState | null;
104	  /**
105	   * Full set of session config options as reported by the agent. The model
106	   * selector is one of these (category === 'model'). Authoritative — updated
107	   * from newSession/loadSession responses, setSessionConfigOption responses,
108	   * and config_option_update notifications.
109	   */
110	  readonly configOptions: readonly SessionConfigOption[];
111	  /** Slash commands the agent currently supports. */
112	  readonly availableCommands: readonly AvailableCommand[];
113	  /**
114	   * The stop reason from the last completed turn. Null on first start or
115	   * if no turn has completed yet. Drives the composer's notice band.
116	   */
117	  readonly lastStopReason: StopReason | null;
118	  /** Latest context-window and cost figures from usage_update, null until the first notification. */
119	  readonly usage: SessionUsage | null;
120	  /** Monotonic sequence counter — shared across all turns of a conversation. */
121	  readonly nextSeq: number;
122	  /** Counter used to generate unique, stable turn ids. */
123	  readonly nextTurnIndex: number;
124	}
125	
126	export function initialMachineState(conversationId: string): SessionMachineState {
127	  return {
128	    conversationId,
129	    phase: { kind: 'starting' },
130	    committedTurns: [],
131	    pendingPermissions: [],
132	    modes: null,
133	    configOptions: [],
134	    availableCommands: [],
135	    lastStopReason: null,
136	    usage: null,
137	    nextSeq: 0,
138	    nextTurnIndex: 0,
139	  };
140	}
141	
142	// ---------------------------------------------------------------------------
143	// Commands (validated intents — may be rejected)
144	// ---------------------------------------------------------------------------
145	
146	export type Command =
147	  /** Send a user message to the agent. Only valid when phase === 'ready'. */
148	  | { type: 'Prompt'; userUpdate: AgentUpdate }
149	  /** Cancel the in-flight turn. Only valid when phase === 'working'. Idempotent elsewhere. */
150	  | { type: 'Cancel' }
151	  /**
152	   * Resolve a pending permission request. Only valid when the requestId is
153	   * present in pendingPermissions.
154	   */
155	  | { type: 'ResolvePermission'; requestId: string; optionId: string | null }
156	  /** Switch the active session mode. Only valid when modes is non-null and modeId is available. */
157	  | { type: 'SetMode'; modeId: string }
158	  /**
159	   * Change the active model (or any other config option by id). The runtime
160	   * sends this as setSessionConfigOption; the response is authoritative.
161	   */
162	  | { type: 'SetConfigOption'; configId: string; value: string };
163	
164	// ---------------------------------------------------------------------------
165	// Domain events (facts — always folded)
166	// ---------------------------------------------------------------------------
167	
168	export type DomainEvent =
169	  /** Session established via loadSession — replay turn begins. */
170	  | { type: 'ReplayStarted' }
171	  /** Replay turn finished. */
172	  | { type: 'ReplayEnded'; status: Exclude<TurnStatus, 'active'> }
173	  /** Session established via newSession — immediately ready. */
174	  | {
175	      type: 'SessionReady';
176	      modes?: SessionModeState | null;
177	      configOptions?: readonly SessionConfigOption[] | null;
178	    }
179	  /** Session loaded via loadSession — session is ready after replay. Carries session metadata. */
180	  | {
181	      type: 'SessionLoaded';
182	      modes?: SessionModeState | null;
183	      configOptions?: readonly SessionConfigOption[] | null;
184	    }
185	  /** A new live turn begins, opening the working phase. */
186	  | { type: 'PromptStarted'; userUpdate: AgentUpdate }
187	  /** A turn-level update arrived from the agent. */
188	  | { type: 'Updated'; update: AgentUpdate }
189	  /** The active turn ended. */
190	  | { type: 'TurnEnded'; outcome: TurnOutcome }
191	  /** User initiated cancellation — transition to cancelling. */
192	  | { type: 'CancellationRequested' }
193	  /** Agent requested user permission for a tool call. */
194	  | { type: 'PermissionRequested'; request: AcpPermissionRequest }
195	  /** A pending permission was resolved (by user or by drain). */
196	  | { type: 'PermissionResolved'; requestId: string }
197	  /** Session-scoped metadata changed (modes / configOptions / availableCommands / usage). */
198	  | {
199	      type: 'MetaChanged';
200	      modes?: SessionModeState | null;
201	      configOptions?: readonly SessionConfigOption[] | null;
202	      availableCommands?: readonly AvailableCommand[] | null;
203	      usage?: SessionUsage | null;
204	    }
205	  /** The agent process exited or the connection closed. */
206	  | { type: 'ProcessClosed'; exitCode: number | null };
207	
208	export type TurnOutcome = { kind: 'stopped'; stopReason: StopReason } | { kind: 'errored' };
209	
210	// ---------------------------------------------------------------------------
211	// Effects (outputs that the runtime interprets — no I/O inside the machine)
212	// ---------------------------------------------------------------------------
213	
214	export type Effect =
215	  /** Emit the current lifecycle + activeTurnId to the listener. */
216	  | { type: 'state' }
217	  /** Emit a turn update to the listener. */
218	  | { type: 'update'; turnId: string; seq: number; update: AgentUpdate }
219	  /** Commit the turn to history and notify the listener. */
220	  | { type: 'turnCommitted'; turn: AcpTurn }
221	  /** Notify the listener of a new permission request. */
222	  | { type: 'permissionRequest'; request: AcpPermissionRequest }
223	  /**
224	   * Notify the listener that a permission was resolved. Also answers the
225	   * non-serializable resolver callback held by the runtime.
226	   */
227	  | { type: 'permissionResolved'; requestId: string; cancelled: boolean }
228	  /** Notify the listener that session-scoped metadata changed. */
229	  | { type: 'meta' }
230	  /** Notify the listener that the session closed. */
231	  | { type: 'closed'; exitCode: number | null }
232	  /** Emit start/stop/error agent lifecycle events. */
233	  | { type: 'agentEvent'; phase: 'start' | 'stop' | 'error' }
234	  /** Log a diagnostic warning for unexpected but non-fatal situations. */
235	  | { type: 'warn'; message: string };
236	
237	// ---------------------------------------------------------------------------
238	// decide — pure validation, no state change
239	// ---------------------------------------------------------------------------
240	
241	/**
242	 * Validates a command against the current state. Returns the list of
243	 * DomainEvents to fold if valid, or an AcpRuntimeError if not.
244	 */
245	export function decide(
246	  s: SessionMachineState,
247	  cmd: Command
248	): Result<DomainEvent[], AcpRuntimeError> {
249	  switch (cmd.type) {
250	    case 'Prompt': {
251	      if (!isPromptReady(phaseToLifecycle(s.phase))) {
252	        return acpErr.invalidState(\`Cannot send a prompt while session is '\${s.phase.kind}'\`);
253	      }
254	      return ok([{ type: 'PromptStarted', userUpdate: cmd.userUpdate }]);
255	    }
256	
257	    case 'Cancel': {
258	      if (s.phase.kind !== 'working') {
259	        // Idempotent — cancelling or already ready/closed is fine
260	        return ok([]);
261	      }
262	      return ok([{ type: 'CancellationRequested' }]);
263	    }
264	
265	    case 'ResolvePermission': {
266	      const found = s.pendingPermissions.some((p) => p.requestId === cmd.requestId);
267	      if (!found) {
268	        return acpErr.invalidState(\`No pending permission request with id '\${cmd.requestId}'\`);
269	      }
270	      return ok([{ type: 'PermissionResolved', requestId: cmd.requestId }]);
271	    }
272	
273	    case 'SetMode': {
274	      if (!s.modes) {
275	        return acpErr.invalidState('Agent does not support session modes');
276	      }
277	      const available = s.modes.availableModes.some((m) => m.id === cmd.modeId);
278	      if (!available) {
279	        return acpErr.setModeFailed({
280	          name: 'Error',
281	          message: \`Mode '\${cmd.modeId}' is not in the available modes list\`,
282	        });
283	      }
284	      // The actual RPC call happens in the runtime; the machine only validates.
285	      // The MetaChanged event arrives after the RPC response and is the truth.
286	      return ok([]);
287	    }
288	
289	    case 'SetConfigOption': {
290	      // Validation: option must exist. The runtime sends the RPC and then
291	      // applies the returned configOptions via a MetaChanged event.
292	      const exists = s.configOptions.some((o) => o.id === cmd.configId);
293	      if (!exists) {
294	        return acpErr.setConfigFailed({
295	          name: 'Error',
296	          message: \`Config option '\${cmd.configId}' is not known\`,
297	        });
298	      }
299	      return ok([]);
300	    }
301	  }
302	}
303	
304	// ---------------------------------------------------------------------------
305	// evolve — pure fold, no side effects
306	// ---------------------------------------------------------------------------
307	
308	/**
309	 * Folds a DomainEvent into a new state, returning the updated state and the
310	 * list of Effects that the runtime must perform (I/O, listener calls, etc.).
311	 * An out-of-place event yields only a \`warn\` Effect and leaves state unchanged.
312	 */
313	export function evolve(
314	  s: SessionMachineState,
315	  ev: DomainEvent
316	): { state: SessionMachineState; effects: Effect[] } {
317	  switch (ev.type) {
318	    case 'ReplayStarted': {
319	      if (s.phase.kind !== 'starting') {
320	        return warn(s, \`ReplayStarted in phase '\${s.phase.kind}'\`);
321	      }
322	      const turn = makeTurn(s, 'replay');
323	      return {
324	        state: {
325	          ...s,
326	          phase: { kind: 'replaying', turn },
327	          nextTurnIndex: s.nextTurnIndex + 1,
328	        },
329	        effects: [{ type: 'state' }],
330	      };
331	    }
332	
333	    case 'ReplayEnded': {
334	      if (s.phase.kind !== 'replaying') {
335	        return warn(s, \`ReplayEnded in phase '\${s.phase.kind}'\`);
336	      }
337	      const turn = s.phase.turn;
338	      const committed: AcpTurn = {
339	        ...turn,
340	        status: ev.status,
341	        endSeq: s.nextSeq,
342	        stopReason: null,
343	      };
344	      return {
345	        state: {
346	          ...s,
347	          phase: { kind: 'ready' },
348	          committedTurns: [...s.committedTurns, committed],
349	        },
350	        effects: [{ type: 'turnCommitted', turn: committed }, { type: 'state' }],
351	      };
352	    }
353	
354	    case 'SessionReady': {
355	      if (s.phase.kind !== 'starting') {
356	        return warn(s, \`SessionReady in phase '\${s.phase.kind}'\`);
357	      }
358	      return {
359	        state: {
360	          ...s,
361	          phase: { kind: 'ready' },
362	          modes: ev.modes ?? s.modes,
363	          configOptions: ev.configOptions ?? s.configOptions,
364	        },
365	        effects: [
366	          { type: 'state' },
367	          ...(needsMetaEffect(s, ev) ? ([{ type: 'meta' }] as Effect[]) : []),
368	        ],
369	      };
370	    }
371	
372	    case 'SessionLoaded': {
373	      if (s.phase.kind !== 'replaying') {
374	        return warn(s, \`SessionLoaded in phase '\${s.phase.kind}'\`);
375	      }
376	      return {
377	        state: {
378	          ...s,
379	          modes: ev.modes ?? s.modes,
380	          configOptions: ev.configOptions ?? s.configOptions,
381	        },
382	        effects: needsMetaEffect(s, ev) ? [{ type: 'meta' }] : [],
383	      };
384	    }
385	
386	    case 'PromptStarted': {
387	      if (s.phase.kind !== 'ready') {
388	        return warn(s, \`PromptStarted in phase '\${s.phase.kind}'\`);
389	      }
390	      const turn = makeTurn(s, 'live');
391	      const seq = s.nextSeq;
392	      // Record the synthesized user message as the leading update
393	      const turnWithUser: AcpTurn = {
394	        ...turn,
395	        updates: [{ seq, update: ev.userUpdate }],
396	      };
397	      return {
398	        state: {
399	          ...s,
400	          phase: { kind: 'working', turn: turnWithUser },
401	          nextSeq: seq + 1,
402	          nextTurnIndex: s.nextTurnIndex + 1,
403	        },
404	        effects: [
405	          { type: 'state' },
406	          { type: 'update', turnId: turn.id, seq, update: ev.userUpdate },
407	          { type: 'agentEvent', phase: 'start' },
408	        ],
409	      };
410	    }
411	
412	    case 'Updated': {
413	      const active = activeTurnFromPhase(s.phase);
414	      if (!active) {
415	        return warn(s, \`Updated with no active turn (phase: '\${s.phase.kind}')\`);
416	      }
417	      const seq = s.nextSeq;
418	      const updatedTurn: AcpTurn = {
419	        ...active,
420	        updates: [...active.updates, { seq, update: ev.update }],
421	      };
422	      return {
423	        state: {
424	          ...s,
425	          phase: replaceTurnInPhase(s.phase, updatedTurn),
426	          nextSeq: seq + 1,
427	        },
428	        effects: [{ type: 'update', turnId: active.id, seq, update: ev.update }],
429	        // NB: lifecycle deliberately unchanged — Updated never flips to 'working'
430	      };
431	    }
432	
433	    case 'TurnEnded': {
434	      const active = activeTurnFromPhase(s.phase);
435	      if (!active) {
436	        return warn(s, \`TurnEnded with no active turn (phase: '\${s.phase.kind}')\`);
437	      }
438	      const stopReason = ev.outcome.kind === 'stopped' ? ev.outcome.stopReason : null;
439	      const status: Exclude<TurnStatus, 'active'> =
440	        ev.outcome.kind === 'errored'
441	          ? 'error'
442	          : stopReason === 'cancelled'
443	            ? 'cancelled'
444	            : 'complete';
445	      const committed: AcpTurn = {
446	        ...active,
447	        status,
448	        endSeq: s.nextSeq,
449	        stopReason,
450	      };
451	      return {
452	        state: {
453	          ...s,
454	          phase: { kind: 'ready' },
455	          committedTurns: [...s.committedTurns, committed],
456	          lastStopReason: stopReason,
457	        },
458	        effects: [
459	          { type: 'turnCommitted', turn: committed },
460	          { type: 'state' },
461	          { type: 'agentEvent', phase: ev.outcome.kind === 'errored' ? 'error' : 'stop' },
462	        ],
463	      };
464	    }
465	
466	    case 'CancellationRequested': {
467	      if (s.phase.kind !== 'working') {
468	        return warn(s, \`CancellationRequested in phase '\${s.phase.kind}'\`);
469	      }
470	      // Drain all pending permissions with cancelled=true
471	      const drainEffects: Effect[] = s.pendingPermissions.map((p) => ({
472	        type: 'permissionResolved' as const,
473	        requestId: p.requestId,
474	        cancelled: true,
475	      }));
476	      return {
477	        state: {
478	          ...s,
479	          phase: { kind: 'cancelling', turn: s.phase.turn },
480	          pendingPermissions: [],
481	        },
482	        effects: [...drainEffects, { type: 'state' }],
483	      };
484	    }
485	
486	    case 'PermissionRequested': {
487	      return {
488	        state: {
489	          ...s,
490	          pendingPermissions: [...s.pendingPermissions, ev.request],
491	        },
492	        effects: [{ type: 'permissionRequest', request: ev.request }],
493	      };
494	    }
495	
496	    case 'PermissionResolved': {
497	      return {
498	        state: {
499	          ...s,
500	          pendingPermissions: s.pendingPermissions.filter((p) => p.requestId !== ev.requestId),
501	        },
502	        effects: [{ type: 'permissionResolved', requestId: ev.requestId, cancelled: false }],
503	      };
504	    }
505	
506	    case 'MetaChanged': {
507	      return {
508	        state: {
509	          ...s,
510	          modes: ev.modes !== undefined ? (ev.modes ?? s.modes) : s.modes,
511	          configOptions:
512	            ev.configOptions !== undefined
513	              ? (ev.configOptions ?? s.configOptions)
514	              : s.configOptions,
515	          availableCommands:
516	            ev.availableCommands !== undefined
517	              ? (ev.availableCommands ?? s.availableCommands)
518	              : s.availableCommands,
519	          usage: ev.usage !== undefined ? (ev.usage ?? s.usage) : s.usage,
520	        },
521	        effects: [{ type: 'meta' }],
522	      };
523	    }
524	
525	    case 'ProcessClosed': {
526	      const drainEffects: Effect[] = s.pendingPermissions.map((p) => ({
527	        type: 'permissionResolved' as const,
528	        requestId: p.requestId,
529	        cancelled: true,
530	      }));
531	      const effects: Effect[] = [...drainEffects];
532	      const active = activeTurnFromPhase(s.phase);
533	      let newCommittedTurns = s.committedTurns;
534	      if (active) {
535	        const errorTurn: AcpTurn = {
536	          ...active,
537	          status: 'error',
538	          endSeq: s.nextSeq,
539	          stopReason: null,
540	        };
541	        newCommittedTurns = [...s.committedTurns, errorTurn];
542	        effects.push({ type: 'turnCommitted', turn: errorTurn });
543	      }
544	      effects.push({ type: 'state' }, { type: 'closed', exitCode: ev.exitCode });
545	      return {
546	        state: {
547	          ...s,
548	          phase: { kind: 'closed', exitCode: ev.exitCode },
549	          committedTurns: newCommittedTurns,
550	          pendingPermissions: [],
551	        },
552	        effects,
553	      };
554	    }
555	  }
556	}
