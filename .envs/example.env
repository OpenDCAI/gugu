# ══════════════════════════════════════════════════════════════════════════════
# 唯一的 env 模板（就在 `.envs/` 里，跟它服务的目录待在一起）。一套环境 = 一个文件。
#
#   cp .envs/example.env .envs/prod.env          # 生产
#   cp .envs/example.env .envs/shared-test.env   # 预发（共享测试库）
#   cp .envs/example.env .envs/local.env         # 开发（本机 docker，scripts/local-dev-db.sh）
#
#   GUGU_DB_TARGET=shared-test pnpm dev     # 点名哪套，那套整体生效
#   GUGU_DB_TARGET=prod pnpm build:app
#
# 为什么一套一个文件：咕咕有三套库，URL 与密钥各不相同。一个文件只装得下一套，
# 另外两套无处可放就只能靠记 —— 记错就是连错库（#2782）。
#
# 为什么放 .envs/ 子目录：vite 会自动加载 .env.<mode>（生产构建就是 .env.production）。
# 存储文件一旦落进它的 cascade，存储就等于激活，而且是**叠加**式的 —— 没写全的键会静默
# 落回别处，凑出「URL 来自 A 库、密钥来自 B 库」的半套错。子目录 vite 从不扫。
#
# ❌ .env.local 已退役。它此前只被 vite 与 env-file.ts 读，而 publish-oss-*.cjs /
#    android-gradle-build.sh / feedback-router.mjs 等入口直读 process.env —— 于是「cp 到
#    .env.local」对下面「发版上传 / Android 签名」那批键**从来没生效过**，得自己 export。
#    现在全在一个文件里，点名即整套生效。已有 .env.local 的：
#      node scripts/build/build-env-preflight.mts --migrate <prod|shared-test|local>
#
# ❌ 真实值不进 git（.envs/ 已 gitignore，只有本模板入库）。每套的完整值经对应的
#    owner-approved repo-external handoff 交接，❌ 跨环境拼接。
# ══════════════════════════════════════════════════════════════════════════════

# ── 必填：四个连接键必须写全 ──────────────────────────────────────────────
# 缺任何一个，preflight 都会中止构建 —— 缺的那个会静默落回别处，正是半套错的来源。
# renderer / electron 读 VITE_*，node（CLI / scripts / agent runtime）读 GUGU_*。
# 同一套里这两组必须指向同一个库。URL 与 anon key 都是公开值。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GUGU_SUPABASE_URL=
GUGU_SUPABASE_ANON_KEY=

# 自有 Supabase 的社区部署：未部署官方托管/模型服务时分别设为 false。
# 两项分别判断：本地助理可以使用官方模型；自建 server 不代表购买官方托管。
# 留空保留现有官方构建的行为。此配置不授予官方资源或会员权益。
GUGU_CLOUD_COMPUTER_ENABLED=
GUGU_PLATFORM_MODELS_ENABLED=

# ── 选填：远程隧道的中转（frps）──────────────────────────────────────────────
# 一库一中转：`frp+wss://<令牌>@<主机>`（frps 部署在反向代理后面，443），或 `frp://<令牌>@<主机>:<端口>`（frp 自己的端口，自建测试用）。
# 构建主进程 / server 包时烘进去，别的电脑经它开远程隧道机器的终端、浏览器、端口。令牌随客户端发出去 = 公开值
# （隔离靠每台机器随机的 stcp 密钥与里面的 SSH），但仍只放在 GitHub environment secret / 本机，❌ 进仓库。
# 不填 = 这个构建的远程隧道机器只有聊天，没有终端 / 浏览器 / 端口（CI 出 Linux 包时不填直接拒绝出厂）。
GUGU_RELAY_URL=

# ── 选填：造号 / 线上 schema 操作 ──────────────────────────────────────────
# 不是人人都有这把（找维护者造号也能拿到可登录账号）。它是**分库**的：生产那把对 dev 库
# 会 401「None of the keys was able to decode the JWT」。
SUPABASE_SERVICE_ROLE_KEY=

# ── 选填：集成测试账号 ─────────────────────────────────────────────────────
# 也是分库的 —— `pnpm seed:yatu-accounts` 把 Alice/Bob 建在当时指向的那个库里。
ALICE_EMAIL=
ALICE_PASSWORD=
ALICE_NICKNAME=
BOB_EMAIL=
BOB_PASSWORD=

# ── 选填：服务端 LLM（edge functions 与仓库 Node jobs，不进客户端 bundle）────
GUGU_SERVER_LLM_BASE_URL=
GUGU_SERVER_LLM_API_KEY=
# standard：feedback-router
GUGU_SERVER_LLM_MODEL=
# thinking：team-generate（需开思考且能在 edge deadline 内完成）
GUGU_SERVER_LLM_THINKING_MODEL=

# ── 选填：发版上传（只有发版的人要填，通常只填在 prod 那套）───────────────
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
GUGU_DOWNLOAD_BASE_URL=

# ── 选填：Android 签名（同上，只有出 release apk 才要）─────────────────────
ANDROID_KEYSTORE_PATH=/absolute/path/to/gugu-release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=gugu-release
ANDROID_KEY_PASSWORD=

# ── 选填：Windows agent runtime ────────────────────────────────────────────
GUGU_POWERSHELL_BIN=
GUGU_POWERSHELL_STARTUP_TIMEOUT_MS=

# ── #1078/#1397 对外分享公开 web 入口（渲染期 inline，URL 是公开值）─────────
# owner 2026-06-25 定域名。承载邀请/分享链接；未设 → agent 分享 tab fail-loud（不出死链接）。
VITE_GUGU_WEB_URL=https://app.gugu.nextmind.space

# 官方部署专用的支付、运营台（中台）与网关管理配置不在社区模板里，由官方私有仓维护。
