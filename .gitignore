artifacts/
e2e-frames/


# design-sync 产物(那次一次性导出的脚手架已移除,踩坑记录见 design notes;
# 这几条留着,是因为按笔记重跑一次还会生成它们)
.ds-sync/
ds-bundle/
apps/desktop/src/styles/.ds-compiled.css
e2e-video-out*/

# python bytecode
__pycache__/
*.pyc

# Tier 2 personal local Supabase stack (scripts/local-dev-db.sh)
.local/gugu-dev-db/
.gugu-precheck.json

# @@@task-fusion (#2802) — 任务页开发库快照(tooling/db/dev.db):
# 内容是真机开发会话(PR、文件索引、safeStorage 密文 token),不该进咕咕的树。这条防它被提交(WAL 的 -shm/-wal 只要读一次就会生成)。
apps/desktop/session-tooling/db/

# @@@storybook-gate (#3526) — storybook build 的产物目录。CI 的 storybook job 用 `clean: false`
# 复用 slot,产物就留在 checkout 里;不忽略的话它们随时可能被顺手 commit 进来。
storybook-static/
storybook-static-chat/
# 本地取证/实验草稿目录(不入库)
.scratch/

# @@@5856 playwright-collection-guard 自检时在仓根建的一次性脚手架(随机后缀目录)。
# 它跑完就删,但 `git add -A` 会在那个窗口里把它逮进来 —— 2026-09-19 已经发生过一次。
.playwright-collection-guard-*/
# Pinned, platform-specific installer engine, materialized by build:mise.
/mise-bundle/
# generated by scripts/build-frpc-bundle.mjs (远程隧道的中转客户端)
/frpc-bundle/

# SQLite inspection sidecars are transient, including for checked-in fixtures.
apps/desktop/session-tooling/fixtures/*.db-wal
apps/desktop/session-tooling/fixtures/*.db-shm
