dist-phone
out
# 根锚定:裸 `release` 会匹配任意深度下同名目录;要挡的只有 electron-builder 的根输出目录。
/release
build
coverage
resources/bin/gugu
resources/bin/gugu.exe
.gugu-runtime-build/
# #7199 原生组件:SwiftPM 的编译目录,与 scripts/build-mac-native.mjs / build-win-native.mjs 的产物(打包时进 Resources/mac-native、resources/win-native)
.build/
/mac-native/
/win-native/
# @@@env-ignore (#2782) - 原先只挡 .env / .env.local / .env.*.local，`.env.production` 这类
# 「mode 文件」没被挡住，而 vite 生产构建恰好会加载它 —— 谁建了它就会连值一起提交。
# 一律挡住 .env*，只放行入库的模板。
.env
.env.*
!.env.example
# @@@one-file-per-env (#2782) - 一套环境一个文件的登记处。放子目录是刻意的:vite 会自动加载
# .env.<mode>(生产构建就是 .env.production),存储文件一旦落进它的 cascade 就等于被激活,
# 而且是叠加式激活 —— 没写全的键会静默落回 .env.local,凑出 URL 与密钥分属两库的半套错。
# 子目录 vite 从不扫,所以这里的三套是纯惰性存储,只有 GUGU_DB_TARGET 选中才整套生效。
# 装真实凭据的那几份(prod/shared-test/local)一律不入库;唯一入库的是 example.env ——
# 模板跟它服务的目录待在一起,别人 clone 下来 `cp .envs/example.env .envs/<target>.env` 就完事。
.envs/*
!.envs/example.env
*.local

# Playwright MCP logs
.playwright-mcp/
.playwright-cli/

# Playwright E2E output
test-results/
playwright-report/

# gugu-supabase 的检出(#6322:CI 的契约 job 与发版闸签到这里)
.gugu-supabase/

# Audit screenshots
*.png
!public/assets/**/*.png
# 打包输入要入库:托盘/菜单栏图标与 macOS 三态包图层(scripts/gen-tray-icons.py、gen-app-icons.py 生成,打包清单直接引用)和它们的源图
!build-resources/**/*.png
# 安卓通知小图标,同一脚本同源生成(capacitor.config.ts 的 LocalNotifications.smallIcon 引用)
!apps/mobile/android/app/src/main/res/drawable-*/ic_stat_gugu.png
# 安卓启动器图标三层(含 Android 13+ 的主题图标层),scripts/gen-app-icons.py 生成
!apps/mobile/android/app/src/main/res/mipmap-*/*.png
# 横幅出图的参考输入(scripts/imagegen/manifests/ 按 sha256 记账)
!scripts/imagegen/inputs/**/*.png
# 预装 App 的图片(manifest 的 icon 与页面用的图,随包装上)
!apps/desktop/preinstalled-apps/**/*.png

# 通用日志和 editor 备份
*.log
*.swp
*~
*.bak
*.bak-*
*.jks
*.keystore

