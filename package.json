{
  "name": "gugu",
  "productName": "咕咕",
  "version": "0.2.58",
  "description": "Gugu desktop chat client",
  "author": "Gugu",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "apps/desktop/dist-electron/main.js",
  "scripts": {
    "android:build": "pnpm build:mobile-agent && pnpm cap:sync && scripts/android-gradle-build.sh assembleDebug",
    "android:build:release": "pnpm build:mobile-agent && pnpm cap:sync && scripts/android-gradle-build.sh assembleRelease",
    "build": "pnpm build:app && electron-builder",
    "build:acp": "node scripts/fetch-acp-adapters.mjs",
    "build:app": "pnpm preflight:env && pnpm build:tmux && pnpm build:acp && pnpm build:mise && pnpm build:frpc && tsgo --noEmit && tsx scripts/build-electron-app.mts && pnpm gate:bake && pnpm rebuild:native && node scripts/build-provenance.mjs --write",
    "build:app:pack": "node scripts/typecheck-unless-proven.mjs && pnpm build:app:ci",
    "build:app:ci": "pnpm preflight:env && pnpm build:tmux && pnpm build:acp && pnpm build:mise && pnpm build:frpc && tsx scripts/build-electron-app.mts && pnpm gate:bake && node scripts/build-provenance.mjs --write",
    "build:beta": "GUGU_TIER=beta pnpm build:mac",
    "build:linux": "pnpm build:app:pack && electron-builder --linux --x64",
    "build:linux:beta": "GUGU_TIER=beta pnpm build:linux",
    "build:mac": "pnpm build:app:pack && electron-builder --mac",
    "build:mobile-agent": "node scripts/build-mobile-node.mjs && node scripts/build-mobile-agent.mjs",
    "build:psmux": "node scripts/build-psmux-bundle.mjs",
    "build:renderer": "pnpm preflight:node && GUGU_TARGET=web tsgo --noEmit && GUGU_TARGET=web tsx scripts/build-electron-app.mts",
    "build:renderer:ci": "pnpm preflight:node && GUGU_TARGET=web tsx scripts/build-electron-app.mts",
    "build:tmux": "node scripts/build-tmux-bundle.mjs",
    "build:win": "pnpm build:app:pack && pnpm build:psmux && electron-builder --win --x64",
    "e2e:package": "node scripts/e2e-artifact-store.mjs publish",
    "build:win:beta": "GUGU_TIER=beta pnpm build:win",
    "cap:add:android": "pnpm build:renderer && node scripts/phone-web-dir.mjs && cap add android",
    "cap:sync": "pnpm build:renderer && node scripts/phone-web-dir.mjs && cap sync",
    "dev": "node scripts/verify-dev-native.mjs && pnpm build:mise && pnpm build:frpc && vite",
    "dev:alice": "node scripts/verify-dev-native.mjs && pnpm build:mise && pnpm build:frpc && GUGU_USER_DATA_DIR=$HOME/.gugu-alice vite --port=5173",
    "dev:bob": "node scripts/verify-dev-native.mjs && pnpm build:mise && pnpm build:frpc && GUGU_USER_DATA_DIR=$HOME/.gugu-bob vite --port=5174",
    "dev:web": "node scripts/verify-dev-native.mjs && pnpm build:mise && pnpm build:frpc && GUGU_TARGET=web vite --host 0.0.0.0",
    "format": "prettier --write .",
    "i18n:check": "pnpm i18n:extract && pnpm i18n:status && pnpm i18n:check:session",
    "i18n:check:session": "vitest run --project session-main apps/desktop/src/session/renderer/localization/locale-store.test.ts",
    "i18n:extract": "i18next-cli extract --ci --dry-run",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "gate:bake": "node scripts/build-env-preflight.mjs --verify-dist",
    "lint": "pnpm preflight:node && concurrently --group --timings --max-processes 8 --names eslint,console-usage-check,error-outlet-check,user-copy-leak-check,check-session-shell-port,check-case-collisions,check-file-url-paths,check-contract-producers,check-session-chat-ui-geometry,check-ui-visual-spec,check-css-parses,check-main-renderer-icons,gen-icons,ci-spec-coverage,theme-color-check 'pnpm lint:eslint' 'node scripts/console-usage-check.mjs --root apps/desktop/src --root apps/desktop/electron --root apps/desktop/shared --root apps/desktop/session-tooling --root packages/core' 'node scripts/error-outlet-check.mjs --root apps/desktop/electron --root packages' 'node scripts/user-copy-leak-check.mjs --root apps/desktop/src --root apps/desktop/electron --root packages' 'node scripts/check-session-shell-port.mjs' 'node scripts/check-case-collisions.mjs' 'node scripts/check-file-url-paths.mjs' 'node scripts/check-contract-producers.mjs' 'node scripts/check-session-chat-ui-geometry.mjs' 'node scripts/check-ui-visual-spec.mjs' 'node scripts/check-css-parses.mjs' 'node scripts/check-main-renderer-icons.mjs' 'node scripts/gen-icons.mjs --check' 'node scripts/ci-spec-coverage.mjs' 'node scripts/theme-color-check.mjs'",
    "lint:eslint": "node scripts/eslint-cached.mjs . --ext .ts,.tsx,.js,.cjs,.mjs,.mts --report-unused-disable-directives --max-warnings 0",
    "lint:spec-coverage": "node scripts/ci-spec-coverage.mjs",
    "postinstall": "pnpm session:db:setup && node scripts/ensure-electron-binary.mjs",
    "preflight:env": "node scripts/build-env-preflight.mjs",
    "preflight:node": "node scripts/node-version-preflight.mjs",
    "rebuild:native": "node scripts/rebuild-native.cjs && node scripts/verify-dev-native.mjs",
    "rebuild:native:isolated": "node scripts/rebuild-native-isolated.mjs",
    "release:manifest": "node scripts/aggregate-release-manifest.cjs",
    "smoke:agent-acp": "node scripts/p0-agent-acp-smoke.mjs",
    "storybook:session-chat-ui": "storybook dev -p 6007 -c packages/session-chat-ui/.storybook",
    "storybook:session-ui": "storybook dev -p 6006 -c packages/session-ui/.storybook",
    "session:db:fixtures": "vitest run --project session-fixtures",
    "session:db:setup": "cd apps/desktop/session-tooling/node-deps && npm install --workspaces=false",
    "session:test:db": "vitest run --project session-main-db",
    "session:test:migrations": "vitest run --project session-migrations",
    "test": "vitest run --project gugu-integration",
    "test:browser": "vitest run --project session-browser --project session-chat-ui-browser",
    "test:unit": "pnpm preflight:node && vitest run --project gugu --project tooling --project session-packages --project session-main --project session-chat-ui --project session-chat-ui-browser",
    "test:unit:mutation:worker-attribution": "tsx scripts/vitest-worker-attribution-mutation.ts",
    "typecheck": "pnpm preflight:node && tsgo --noEmit",
    "build:mise": "node scripts/build-mise-bundle.mjs",
    "build:frpc": "node scripts/build-frpc-bundle.mjs"
  },
