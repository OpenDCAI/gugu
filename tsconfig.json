{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./apps/desktop/src/*"],
      "@gugu/core": ["./packages/core/src/index.ts"],
      "@gugu/core/*": ["./packages/core/src/*"],
      "@main/*": ["./apps/desktop/electron/session/main/*"],
      "@main": ["./apps/desktop/electron/session/main"],
      "@shared/*": ["./apps/desktop/src/session/shared/*"],
      "@shared": ["./apps/desktop/src/session/shared"],
      "@renderer/*": ["./apps/desktop/src/session/renderer/*"],
      "@renderer": ["./apps/desktop/src/session/renderer"],
      "@root/*": ["./apps/desktop/electron/session/*"],
      "@root": ["./apps/desktop/electron/session"],
      "@tooling/*": ["./apps/desktop/session-tooling/*"],
      "@tooling": ["./apps/desktop/session-tooling"],
      "@session-assets/*": ["./apps/desktop/src/session/assets/*"],
      "@session-assets": ["./apps/desktop/src/session/assets"],
      "@session-types/*": ["./apps/desktop/src/session/types/*"],
      "@session-types": ["./apps/desktop/src/session/types"],
      "@session-ui/*": ["./packages/session-ui/src/*"],
      "@session-chat/*": ["./packages/session-chat-ui/src/*"]
    }
  },
  "include": ["apps/desktop", "packages", "scripts", "tests", "playwright.config.mts", "vite.config.mts", "vitest.config.ts"],
  "//include-e2e": "#6270:tests/e2e/ 只剩 PR CI 真跑的 ci/local 三条,随 tests 一起进主类型检查,不再单开 tsconfig.e2e.json / typecheck:e2e。",
  "//exclude": "@@@task-fusion (#2802) — 这里是全仓**唯一**的 tsconfig:从前的",
  "//exclude2": "tsconfig.emdash-bridge.json 与 7 个包各自的 tsconfig 都已删除。node_modules 要重列一次,",
  "//exclude3": "因为自定义 exclude 会覆盖默认值。",
  "exclude": ["node_modules"]
}
